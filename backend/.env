# Environment Configuration for Pair With Code Backend

# Node environment
NODE_ENV=development

# Server
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=pairwithcode
DB_PASSWORD=pairwithcode123
DB_NAME=pairwithcode
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT & Auth
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# GitHub OAuth (optional - leave empty to disable)
GITHUB_CLIENT_ID=0v231ir6qskFd4Ru237v
GITHUB_CLIENT_SECRET=e45182db33f97e13ab951704bc5ec7f27f010e35
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# GitLab OAuth (optional - leave empty to disable)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_CALLBACK_URL=http://localhost:3000/auth/gitlab/callback

# Storage (local or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage

# AWS S3 (for production - optional)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Session Recording
RECORDING_ENABLED=true
RECORDING_FPS=30
RECORDING_BITRATE=2500k
RECORDING_FORMAT=mp4
