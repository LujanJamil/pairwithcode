{
  "name": "pair-with-code",
  "displayName": "Pair With Code PRO",
  "publisher": "LJ-Tech",
  "version": "1.0.4",
  "description": "Real-time collaborative IDE with instant pair programming, code review, live analytics, and AI conflict resolution. Code together globally.",
  "repository": {
    "type": "git",
    "url": "https://github.com/LujanJamil/pairwithcode"
  },
  "homepage": "https://pairwithcode.dev",
  "bugs": {
    "url": "https://github.com/LujanJamil/pairwithcode/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#6366f1",
    "theme": "dark",
    "preview": false
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "collaboration",
    "pair-programming",
    "real-time",
    "code-review",
    "analytics",
    "socket.io",
    "live-share",
    "coding",
    "remote-work",
    "team-productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pairtool.copyRoomId",
        "title": "Copy Room ID",
        "category": "Pair With Code"
      },
      {
        "command": "pairtool.stopSharing",
        "title": "Stop Sharing Session",
        "category": "Pair With Code"
      },
      {
        "command": "pairtool.menu",
        "title": "Menu",
        "category": "Pair With Code"
      },
      {
        "command": "pairtool.joinRoom",
        "title": "Join Room",
        "category": "Pair With Code"
      },
      {
        "command": "pairtool.recentRooms",
        "title": "Recent Rooms",
        "category": "Pair With Code"
      },
      {
        "command": "pairtool.openChat",
        "title": "Open Chat",
        "category": "Pair With Code",
        "when": "pairWithCode.isConnected"
      },
      {
        "command": "pairtool.openPresence",
        "title": "Show Collaborators",
        "category": "Pair With Code",
        "when": "pairWithCode.isConnected"
      },
      {
        "command": "pairtool.openSettings",
        "title": "Settings",
        "category": "Pair With Code"
      },
      {
        "command": "pairtool.openShortcuts",
        "title": "Keyboard Shortcuts",
        "category": "Pair With Code"
      },
      {
        "command": "pairtool.openAnalytics",
        "title": "Session Analytics",
        "category": "Pair With Code",
        "when": "pairWithCode.isConnected"
      },
      {
        "command": "pairtool.openCodeReview",
        "title": "Code Review",
        "category": "Pair With Code",
        "when": "pairWithCode.isConnected"
      },
      {
        "command": "pairtool.loginGitHub",
        "title": "Sign in with GitHub",
        "category": "Pair With Code"
      },
      {
        "command": "pairtool.loginGitLab",
        "title": "Sign in with GitLab",
        "category": "Pair With Code"
      },
      {
        "command": "pairtool.logout",
        "title": "Logout",
        "category": "Pair With Code"
      },
      {
        "command": "pairtool.openRecording",
        "title": "Session Recording",
        "category": "Pair With Code",
        "when": "pairWithCode.isConnected"
      },
      {
        "command": "pairtool.openTerminal",
        "title": "Shared Terminal",
        "category": "Pair With Code",
        "when": "pairWithCode.isConnected"
      },
      {
        "command": "pairtool.openAV",
        "title": "Video Call",
        "category": "Pair With Code",
        "when": "pairWithCode.isConnected"
      },
      {
        "command": "pairtool.setupServer",
        "title": "Setup Self-Hosted Server",
        "category": "Pair With Code"
      }
    ],
    "configuration": {
      "title": "Pair With Code",
      "properties": {
        "pairWithCode.serverUrl": {
          "type": "string",
          "default": "https://pair-with-code-backend.onrender.com",
          "description": "Server URL for collaboration. Change this to point to your own server.",
          "scope": "application"
        },
        "pairWithCode.userName": {
          "type": "string",
          "default": "",
          "description": "Your display name in collaboration sessions. Leave blank to use your Git username.",
          "scope": "application"
        },
        "pairWithCode.autoJoin": {
          "type": "boolean",
          "default": false,
          "description": "Automatically join the last room on startup.",
          "scope": "application"
        },
        "pairWithCode.followMode": {
          "type": "boolean",
          "default": true,
          "description": "Automatically follow partner's file switches.",
          "scope": "application"
        },
        "pairWithCode.autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reconnect on connection loss.",
          "scope": "application"
        },
        "pairWithCode.theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ],
          "default": "auto",
          "description": "Chat and UI theme preference.",
          "scope": "application"
        },
        "pairWithCode.showActivityIndicators": {
          "type": "boolean",
          "default": true,
          "description": "Show typing indicators and activity highlights.",
          "scope": "application"
        },
        "pairWithCode.maxChatHistory": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Maximum number of chat messages to keep per session.",
          "scope": "application"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pair-collaboration",
          "title": "Pair Session",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "pair-collaboration": [
        {
          "id": "pairPresence",
          "name": "Active Collaborators",
          "when": "pairWithCode.isConnected",
          "icon": "resources/activitybar.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3",
    "tweetnacl": "^1.0.3"
  }
}
